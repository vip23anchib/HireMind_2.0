# ==============================================================================
# HireMind Enterprise ATS Environment Configuration Template
# Duplicate this file to .env and configure values before starting the application
# ==============================================================================

# Application Environment (development or production)
DJANGO_SETTINGS_MODULE=my_project.settings.development

# Security
SECRET_KEY=django-insecure-replace-with-a-random-64-char-string-in-production
DEBUG=True

# Hostnames & Networking
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173

# Database Configuration (PostgreSQL in production; SQLite fallback in development)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://hiremind_user:hiremind_secure_pass_2026@localhost:5432/hiremind
DB_SSL_REQUIRE=False

# Celery & Redis Task Broker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Security Headers (Production only)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
